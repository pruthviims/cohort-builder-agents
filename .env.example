# Copy to .env and fill in. Placeholders only: never commit real tokens, keys or passwords.

# ---- environment and authentication -------------------------------------------------
CB_ENV=production                          # production (default, fails closed) | development
CB_AUTH_TOKENS_FILE=/etc/cohort-builder/tokens.yaml   # hashed token entries (see docs/SECURITY.md)
CB_ALLOW_SELF_APPROVAL=false               # true lets an author approve their own definition (not recommended)

# development only (refused when CB_ENV=production)
# CB_AUTH_DEV_BYPASS=true
# CB_AUTH_DEV_SUBJECT=dev.user
# CB_AUTH_DEV_ROLES=viewer,author
# CB_ALLOW_DRAFT_EXECUTION=true

# ---- LLM ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-api-key>
CB_MODEL=claude-sonnet-5-5
CB_TEMPERATURE=0
CB_LLM_MODE=cached                         # cached | live | replay

# ---- data -----------------------------------------------------------------------------
CB_DB_PATH=data/cohort_builder.duckdb
CB_DATASET=omop_demo                       # or iqvia_laad

# ---- execution limits -----------------------------------------------------------------
CB_QUERY_TIMEOUT_SECONDS=300
# CB_DUCKDB_MEMORY_LIMIT=4GB
# CB_DUCKDB_THREADS=4
CB_DUCKDB_LOCK_EXTERNAL_ACCESS=true

# ---- MCP server -----------------------------------------------------------------------
CB_MCP_USER=<operator-name>
CB_MCP_TENANT=default
# HTTP mode only:
# CB_MCP_TOKEN=<long-random-secret>
# CB_MCP_ALLOWED_HOSTS=cohorts.example.org:*

# ---- tests ----------------------------------------------------------------------------
# CB_TEST_POSTGRES_DSN=postgresql://postgres:<password>@localhost:5432/postgres
